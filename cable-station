#!/usr/bin/env -S uv run --script
# /// script
# requires-python = ">=3.11"
# dependencies = ["pillow>=10"]
# ///
"""cable-station: test USB-C cables on an Apple Silicon Mac and print a wrap-flag label.

One cable at a time: plug it between a free Mac USB-C port and a known fast partner
device (default: the OWC Envoy Pro FX "Razor Crest"). The station reads three things
and prints a 9 mm wrap-flag on the P-touch:

  1. What the cable CLAIMS: its e-marker chip, read by macOS over USB PD (SOP').
  2. What the link NEGOTIATED: Thunderbolt/USB4, USB 3 or USB 2, at what speed.
  3. What it ACTUALLY MOVES: a read-only throughput test from the partner drive.

The label comes from the measured link, never from the chip alone; when the two
disagree the screen says so. See README.md for the method and its limits.
"""
from __future__ import annotations

import argparse
import datetime as dt
import fcntl
import json
import os
import plistlib
import select
import subprocess
import sys
import time
from dataclasses import dataclass, field, asdict
from pathlib import Path

RESULTS = Path.home() / ".local/share/cable-station/results.jsonl"
FLAG_DIR = Path.home() / ".local/share/cable-station/flags"
FONT = "/System/Library/Fonts/Supplemental/Arial Bold.ttf"
F_NOCACHE = 48  # fcntl command on macOS: bypass the unified buffer cache for this fd

# Read-throughput floors for the default partner (OWC Envoy Pro FX: TB3 PCIe NVMe,
# ASMedia USB bridge). Provisional, from the vendor's figures; tune after real runs.
THROUGHPUT_FLOOR_MBPS = {"tb40": 1500, "tb20": 900, "usb10": 600, "usb5": 300, "usb2": 25}

# --- USB PD cable e-marker decoding (USB PD 3.x, Cable VDO / Active Cable VDO1) ---

SPEED = {0: ("USB 2.0", 0.48), 1: ("USB 3.2 Gen 1", 5), 2: ("USB 3.2 Gen 2", 10),
         3: ("USB4 Gen 3", 40), 4: ("USB4 Gen 4", 80)}
LATENCY_M = {1: "~1 m", 2: "~2 m", 3: "~3 m", 4: "~4 m", 5: "~5 m", 6: "~6 m", 7: "~7 m", 8: ">7 m"}
MAX_VBUS_V = {0: 20, 1: 30, 2: 40, 3: 50}


@dataclass
class EMarker:
    vendor_id: int
    product_id: int
    kind: str                 # "passive" | "active" | "other"
    certified: bool           # nonzero XID in the Cert Stat VDO
    usb_speed_code: int
    usb_speed: str
    usb_gbps: float
    current_a: int
    max_vbus_v: int | None    # None on PD 2.0 cables (field did not exist)
    epr: bool
    length: str
    raw_vdos: list[str]

    @property
    def watts(self) -> int:
        if self.epr and self.current_a >= 5 and (self.max_vbus_v or 0) >= 50:
            return 240
        return 20 * self.current_a  # 60 W at 3 A, 100 W at 5 A


def decode_emarker(meta: dict, spec_revision: int | None) -> EMarker | None:
    vdos = [int.from_bytes(b, "little") for b in meta.get("VDOs", [])]
    if len(vdos) < 4:
        return None
    id_header, cert, product, cable = vdos[0], vdos[1], vdos[2], vdos[3]
    ptype = (id_header >> 27) & 0b111
    kind = {0b011: "passive", 0b100: "active"}.get(ptype, "other")
    pd3 = (spec_revision or 0) >= 3  # ioreg's value for PD 3.x cables on M3 (Observed)
    speed_code = cable & 0b111
    name, gbps = SPEED.get(speed_code, (f"unknown speed code {speed_code}", 0))
    current_a = {1: 3, 2: 5}.get((cable >> 5) & 0b11, 3)
    return EMarker(
        vendor_id=id_header & 0xFFFF,
        product_id=(product >> 16) & 0xFFFF,
        kind=kind,
        certified=cert != 0,
        usb_speed_code=speed_code,
        usb_speed=name,
        usb_gbps=gbps,
        current_a=current_a,
        max_vbus_v=MAX_VBUS_V[(cable >> 9) & 0b11] if pd3 else None,
        epr=bool((cable >> 17) & 1) if pd3 else False,
        length=LATENCY_M.get((cable >> 13) & 0b1111, "?"),
        raw_vdos=[f"0x{v:08x}" for v in vdos],
    )


# --- Reading one port's state from the IORegistry ---

@dataclass
class PortState:
    port: int
    connected: bool = False
    transports_active: list[str] = field(default_factory=list)
    partner_vid: int | None = None
    emarker: EMarker | None = None
    usb2_rate: str | None = None
    usb2_product: str | None = None
    usb3_rate: str | None = None
    usb3_product: str | None = None
    cio_active: bool = False
    cio_device: str | None = None
    cio_generation: int | None = None
    cio_cable_speed: int | None = None
    tb_speed: str | None = None       # system_profiler, e.g. "40 Gb/s"
    dp_rate: str | None = None

    def devices(self) -> str:
        return " / ".join(x for x in (self.cio_device, self.usb3_product, self.usb2_product) if x)


def _walk(node, out):
    out.append(node)
    for child in node.get("IORegistryEntryChildren", []):
        _walk(child, out)


def read_ports() -> dict[int, PortState]:
    raw = subprocess.run(["ioreg", "-a", "-l", "-r", "-n", "Port-USB-C"],
                         capture_output=True, check=True).stdout
    roots = plistlib.loads(raw) if raw.strip() else []
    ports: dict[int, PortState] = {}
    for root in roots:
        nodes: list[dict] = []
        _walk(root, nodes)
        num = root.get("PortNumber")
        if num is None:
            continue
        st = PortState(port=num, connected=bool(root.get("ConnectionActive")),
                       transports_active=list(root.get("TransportsActive", [])))
        for n in nodes:
            desc = n.get("TransportDescription") or n.get("Description") or ""
            cls = n.get("IOObjectClass", "")
            if cls == "IOPortTransportComponentCCUSBPDSOPp":
                st.emarker = decode_emarker(n.get("Metadata", {}), n.get("Specification Revision"))
            elif cls == "IOPortTransportComponentCCUSBPDSOP":
                st.partner_vid = n.get("Vendor ID")
            elif cls == "IOPortTransportStateUSB2" and n.get("Active"):
                st.usb2_rate, st.usb2_product = n.get("DataRateDescription"), n.get("Product")
            elif cls == "IOPortTransportStateUSB3" and n.get("Active"):
                st.usb3_rate, st.usb3_product = n.get("DataRateDescription"), n.get("Product")
            elif cls == "IOPortTransportStateCIO" and n.get("Active"):
                st.cio_active = True
                st.cio_device = n.get("Device Model Name") or n.get("Device Vendor Name")
                st.cio_generation = n.get("Generation")
                st.cio_cable_speed = n.get("CableSpeed")
            elif cls == "IOPortTransportStateDisplayPort" and n.get("Active") and "/CIO/" not in desc:
                st.dp_rate = n.get("LinkRateDescription")
        ports[num] = st
    _add_thunderbolt_speeds(ports)
    return ports


def _add_thunderbolt_speeds(ports: dict[int, PortState]) -> None:
    try:
        out = subprocess.run(["system_profiler", "-json", "SPThunderboltDataType"],
                             capture_output=True, check=True, timeout=20).stdout
        buses = json.loads(out).get("SPThunderboltDataType", [])
    except (subprocess.SubprocessError, json.JSONDecodeError):
        return
    for bus in buses:
        rec = bus.get("receptacle_1_tag", {})
        try:
            num = int(rec.get("receptacle_id_key", ""))
        except ValueError:
            continue
        if num in ports and rec.get("receptacle_status_key") == "receptacle_connected":
            ports[num].tb_speed = rec.get("current_speed_key")


# --- Measuring real data movement ---

def volume_physical_disk(volume: Path) -> str | None:
    """The whole physical disk behind an APFS volume ("disk4" for disk4s2), for eject."""
    r = subprocess.run(["diskutil", "info", "-plist", str(volume)], capture_output=True)
    if r.returncode != 0:
        return None
    info = plistlib.loads(r.stdout)
    stores = info.get("APFSPhysicalStores") or []
    dev = stores[0]["APFSPhysicalStore"] if stores else info.get("DeviceIdentifier", "")
    return _whole_disk(dev) if dev else None


def _whole_disk(dev: str) -> str:
    return "disk" + dev[4:].split("s")[0] if dev.startswith("disk") else dev


def read_throughput(volume: Path, seconds: float = 8.0, max_bytes: int = 6 << 30) -> tuple[float, int] | None:
    """Read existing large files with the page cache bypassed. Never writes."""
    files: list[Path] = []
    for dirpath, _dirs, names in os.walk(volume):
        if "/." in dirpath:
            continue
        for name in names:
            p = Path(dirpath) / name
            try:
                if p.stat().st_size >= 256 << 20:
                    files.append(p)
            except OSError:
                pass
        if len(files) >= 40:
            break
    if not files:
        return None
    buf = bytearray(8 << 20)
    total, start = 0, time.monotonic()
    for p in files:
        try:
            fd = os.open(p, os.O_RDONLY)
        except OSError:
            continue
        try:
            fcntl.fcntl(fd, F_NOCACHE, 1)
            while (n := os.readv(fd, [buf])) > 0:
                total += n
                if time.monotonic() - start >= seconds or total >= max_bytes:
                    break
        finally:
            os.close(fd)
        if time.monotonic() - start >= seconds or total >= max_bytes:
            break
    elapsed = time.monotonic() - start
    return (total / elapsed / 1e6 if elapsed > 0 else 0.0), total


# --- Verdict ---

@dataclass
class Verdict:
    link_class: str          # tb40 | tb20 | usb10 | usb5 | usb2 | power | none
    label: str
    notes: list[str]
    throughput_mbps: float | None = None
    throughput_ok: bool | None = None


def _gbps(s: str | None) -> float:
    try:
        return float((s or "").split()[0])
    except ValueError:
        return 0.0


def judge(st: PortState, partner_max_tb: float = 40) -> Verdict:
    em, notes = st.emarker, []
    if st.cio_active:
        tb = _gbps(st.tb_speed) or (40 if (st.cio_generation or 0) >= 3 else 20)
        link_class = "tb40" if tb >= 40 else "tb20"
        if tb >= 40 and em and em.usb_speed_code >= 3:
            label = "USB4 Gen 3x2 (40G)"
            if em.usb_speed_code == 4:
                notes.append(f"Chip claims USB4 Gen 4 (80G); the partner tops out at {partner_max_tb:g}G, "
                             "so only 40G was verified.")
        elif tb >= 40:
            label = "Thunderbolt 3 (40G)"
        else:
            label = f"Thunderbolt 3 ({tb:g}G)"
    elif st.usb3_rate:
        g = _gbps(st.usb3_rate)
        link_class, label = ("usb10", "USB 3.2 Gen 2 (10G)") if g >= 10 else ("usb5", "USB 3.2 Gen 1 (5G)")
    elif st.usb2_rate:
        link_class, label = "usb2", "USB 2.0 (480M)"
    elif st.dp_rate:
        # DisplayPort alt mode runs over the SuperSpeed pairs, so they are wired and working.
        link_class, label = "dp", "USB-C DP alt mode"
        notes.append(f"Video only ({st.dp_rate}): the SuperSpeed pairs work, but no USB data link "
                     "was tested. Retest against the partner drive for a data label.")
    elif st.connected:
        link_class, label = "power", "PWR ONLY"
        notes.append("Power flows but no data link came up. Power-only cables are strictly worse "
                     "than data cables: consider discarding instead of labelling.")
    else:
        return Verdict("none", "", ["No connection at all: the CC wire is broken or the cable is dead. Discard it."])

    if em:
        measured = {"tb40": 40, "tb20": 20, "usb10": 10, "usb5": 5, "usb2": 0.48, "power": 0, "dp": 0}[link_class]
        if em.usb_gbps > measured and link_class not in ("tb40", "dp"):
            notes.append(f"Chip claims {em.usb_speed} ({em.usb_gbps:g}G) but the link only reached "
                         f"{measured:g}G: the chip overclaims or the cable is damaged. Label shows what was measured.")
        if link_class.startswith("tb") and em.usb_speed_code < 2:
            notes.append("Thunderbolt link up although the chip claims only "
                         f"{em.usb_speed}: unusual, check the chip reading.")
        if em.watts > 60:
            label += f" + {em.watts}W"
            notes.append(f"Power rating {em.watts} W is what the chip claims; it is not measured "
                         "by this test (see README: power test).")
    else:
        if link_class in ("usb5", "usb10", "tb20", "tb40"):
            notes.append("No e-marker, yet SuperSpeed data works: out of spec for USB-C to USB-C "
                         "(full-featured cables must be e-marked). Treat as 3 A / 60 W.")
        else:
            notes.append("No e-marker: by the USB-C spec this cable is rated 3 A / 60 W.")
    return Verdict(link_class, label, notes)


# --- Flag rendering and printing ---

def render_flag(text: str, path: Path, max_copy_mm: float = 32.0) -> Path:
    """Wrap-flag per conventions/physical-labeling.md: the text twice, a 20 mm wrap zone
    between, about 90 mm overall. "X + 240W" goes on two lines so the flag stays short."""
    from PIL import Image, ImageDraw, ImageFont
    px_mm = 40                        # render resolution; ptouch-label rescales to the tape
    height = int(7.5 * px_mm)         # printable height on 9 mm tape
    lines = text.split(" + ")
    line_h_mm = 5.6 if len(lines) == 1 else 3.3
    probe = ImageDraw.Draw(Image.new("L", (10, 10)))

    def widest(size_px):
        f = ImageFont.truetype(FONT, size_px)
        return f, max(probe.textlength(s, font=f) for s in lines)

    size = int(line_h_mm * px_mm)
    font, w = widest(size)
    if w > max_copy_mm * px_mm:       # shrink to fit, not below 3 mm text
        size = max(int(size * max_copy_mm * px_mm / w), 3 * px_mm)
        font, w = widest(size)
    copy_w, pad, wrap = int(w), int(3 * px_mm), int(20 * px_mm)
    img = Image.new("L", (pad + copy_w + wrap + copy_w + pad, height), 255)
    d = ImageDraw.Draw(img)
    asc, desc = font.getmetrics()
    block = len(lines) * asc + (len(lines) - 1) * int(0.4 * px_mm)
    y0 = (height - block) // 2
    for x0 in (pad, pad + copy_w + wrap):
        for i, s in enumerate(lines):
            lw = probe.textlength(s, font=font)
            d.text((x0 + (copy_w - lw) / 2, y0 + i * (asc + int(0.4 * px_mm))), s, font=font, fill=0)
    path.parent.mkdir(parents=True, exist_ok=True)
    img.save(path)
    return path


def print_flag(png: Path, model: str, dry_run: bool) -> bool:
    cmd = ["ptouch-label", "--model", model, "--for", "cable", "--kind", "stats",
           "--image", str(png), "--no-trim"]
    if dry_run:
        cmd.append("--dry-run")
    r = subprocess.run(cmd)
    return r.returncode == 0


# --- Screen output ---

B, DIM, RED, GRN, YEL, RST = "\033[1m", "\033[2m", "\033[31m", "\033[32m", "\033[33m", "\033[0m"


def show(title: str, st: PortState, v: Verdict) -> None:
    em = st.emarker
    print(f"\n{B}━━━ {title} ━━━{RST}")
    print(f"{B}Chip (claims){RST}")
    if em:
        cert = "USB-IF certified" if em.certified else "not certified"
        vbus = f"{em.max_vbus_v} V" if em.max_vbus_v else "20 V (PD 2.0 chip)"
        print(f"  {em.kind} cable, {em.usb_speed} ({em.usb_gbps:g}G), {em.current_a} A, max {vbus}"
              f"{', EPR' if em.epr else ''} → {em.watts} W, length {em.length}")
        print(f"  {DIM}vendor 0x{em.vendor_id:04X}, product 0x{em.product_id:04X}, {cert}, "
              f"VDOs {' '.join(em.raw_vdos)}{RST}")
    else:
        print(f"  {YEL}no e-marker{RST}")
    print(f"{B}Link (negotiated){RST}")
    if st.cio_active:
        print(f"  Thunderbolt/USB4 {st.tb_speed or '?'} to {st.cio_device or '?'}"
              f"  {DIM}(gen {st.cio_generation}, cable speed {st.cio_cable_speed}){RST}")
    if st.usb3_rate:
        print(f"  USB 3 {st.usb3_rate} to {st.usb3_product or '?'}")
    if st.usb2_rate:
        print(f"  USB 2 {st.usb2_rate} to {st.usb2_product or '?'}")
    if not (st.cio_active or st.usb3_rate or st.usb2_rate):
        print(f"  {RED}no data link{RST}" if st.connected else f"  {RED}no connection{RST}")
    if v.throughput_mbps is not None:
        col = GRN if v.throughput_ok else RED
        verdict = "OK" if v.throughput_ok else "BELOW the floor for this link: marginal or damaged cable"
        print(f"{B}Data (measured){RST}\n  {col}{v.throughput_mbps:,.0f} MB/s read — {verdict}{RST}")
    for note in v.notes:
        print(f"  {YEL}• {note}{RST}")
    if v.label:
        print(f"{B}Label:{RST} {GRN}{B}{v.label}{RST}")


# --- The station loop ---

def wait_for(pred, timeout: float | None, poll: float = 0.5, watch_enter: bool = False):
    """Poll read_ports() until pred(ports) is truthy. Returns (ports, enter_pressed)."""
    start = time.monotonic()
    while True:
        ports = read_ports()
        if pred(ports):
            return ports, False
        if watch_enter and select.select([sys.stdin], [], [], 0)[0]:
            sys.stdin.readline()
            return ports, True
        if timeout is not None and time.monotonic() - start > timeout:
            return ports, False
        time.sleep(poll)


def settle(port: int, max_wait: float = 15.0, stable_for: float = 3.0) -> PortState:
    """After plug-in, wait until the port's links stop changing (TB training takes seconds)."""
    start, last, since = time.monotonic(), None, time.monotonic()
    while True:
        st = read_ports()[port]
        sig = (st.connected, st.cio_active, st.tb_speed, st.usb3_rate, st.usb2_rate,
               st.emarker.raw_vdos if st.emarker else None)
        if sig != last:
            last, since = sig, time.monotonic()
        has_data = st.cio_active or st.usb3_rate or st.usb2_rate
        if time.monotonic() - since >= stable_for and (has_data or time.monotonic() - start >= max_wait):
            return st
        if time.monotonic() - start >= max_wait + stable_for:
            return st
        time.sleep(0.5)


def partner_on_port(st: PortState, partner: str) -> bool:
    return partner.lower() in st.devices().lower()


def run_station(a) -> int:
    port, volume = a.port, Path("/Volumes") / a.volume
    ports = read_ports()
    if port not in ports:
        print(f"No USB-C port {port}. Ports: {sorted(ports)}")
        return 2
    print(f"{B}cable-station{RST}: test port = Mac USB-C port {port}; partner = {a.partner} "
          f"(volume {a.volume}); printer = {a.model}{' (dry run)' if a.dry_run else ''}.")
    print(f"{DIM}Every test is read-only on the partner drive. Ctrl-C to stop.{RST}")
    if ports[port].connected:
        print(f"Port {port} is in use ({ports[port].devices() or 'something'}). Unplug it to start.")
        wait_for(lambda p: not p[port].connected, None)

    n = 0
    while True:
        print(f"\n{B}Plug the next cable:{RST} Mac port {port} ↔ {a.partner}. "
              f"{DIM}(Press Enter if it is plugged in and nothing happens.){RST}")
        ports, enter = wait_for(lambda p: p[port].connected, None, watch_enter=True)
        n += 1
        if enter and not ports[port].connected:
            st = ports[port]
        else:
            print(f"{DIM}Connected. Waiting for the links to settle…{RST}")
            st = settle(port)
        v = judge(st)

        if v.link_class in ("tb40", "tb20", "usb10", "usb5", "usb2") and not a.no_throughput:
            if not partner_on_port(st, a.partner):
                v.notes.append(f"{a.partner} not seen on port {port} (saw: {st.devices() or 'nothing'}); "
                               "throughput test skipped.")
            else:
                for _ in range(40):           # the volume mounts a few seconds after the link
                    if volume.is_dir():
                        break
                    time.sleep(0.5)
                if volume.is_dir():
                    print(f"{DIM}Reading from {a.volume} for {a.seconds:g} s…{RST}")
                    res = read_throughput(volume, a.seconds)
                    if res:
                        v.throughput_mbps = res[0]
                        v.throughput_ok = res[0] >= THROUGHPUT_FLOOR_MBPS[v.link_class]
                else:
                    v.notes.append(f"Volume {a.volume} did not mount; throughput test skipped.")

        show(f"Cable #{n}", st, v)
        printed, png = False, None
        if v.label and not a.no_print:
            png = render_flag(v.label, FLAG_DIR / f"{dt.datetime.now():%Y%m%d-%H%M%S}-cable{n}.png")
            if a.auto_print:
                choice = ""
            else:
                choice = input(f"Print this flag? [Enter = print, e = edit text, s = skip] ").strip().lower()
            if choice == "e":
                new = input("Label text: ").strip()
                if new:
                    v.label = new
                    png = render_flag(v.label, png)
                choice = ""
            if choice == "":
                printed = print_flag(png, a.model, a.dry_run)

        record = {"time": dt.datetime.now().isoformat(timespec="seconds"), "cable": n,
                  "port": asdict(st), "verdict": asdict(v), "printed": printed,
                  "flag_png": str(png) if png else None}
        RESULTS.parent.mkdir(parents=True, exist_ok=True)
        with RESULTS.open("a") as f:
            f.write(json.dumps(record, default=str) + "\n")

        if volume.is_dir() and partner_on_port(read_ports()[port], a.partner):
            disk = volume_physical_disk(volume)
            if disk:
                print(f"{DIM}Ejecting {a.volume} ({disk}) before you unplug…{RST}")
                r = subprocess.run(["diskutil", "eject", disk], capture_output=True, text=True)
                if r.returncode != 0:
                    print(f"{RED}Eject failed: {r.stderr.strip() or r.stdout.strip()}. "
                          f"Do not unplug until {a.volume} is ejected.{RST}")
                    input("Press Enter once it is ejected… ")
        if read_ports()[port].connected:
            print(f"{B}Unplug the cable.{RST}")
            wait_for(lambda p: not p[port].connected, None)
        if a.once:
            return 0


def snapshot(a) -> int:
    ports = read_ports()
    out = {p: {"state": asdict(st), "verdict": asdict(judge(st)) if st.connected else None}
           for p, st in sorted(ports.items())}
    if a.json:
        print(json.dumps(out, indent=2, default=str))
    else:
        for p, st in sorted(ports.items()):
            if st.connected:
                show(f"Port {p}: {st.devices() or 'connected'}", st, judge(st))
            else:
                print(f"\nPort {p}: empty")
    return 0


def self_test() -> int:
    # The TS5 Plus dock cable on SusanBones port 3, read 2026-11-11.
    meta = {"VDOs": [bytes.fromhex(h) for h in ("1d2b601c", "00000000", "11042b19", "424e0a42")]}
    em = decode_emarker(meta, 3)
    assert em and em.kind == "passive" and em.vendor_id == 0x2B1D and em.product_id == 0x192B
    assert em.usb_speed_code == 2 and em.current_a == 5 and em.max_vbus_v == 50 and em.epr
    assert em.watts == 240 and em.length == "~2 m" and not em.certified
    st = PortState(port=3, connected=True, emarker=em, cio_active=True, cio_device="TS5 Plus",
                   cio_generation=3, cio_cable_speed=3, tb_speed="40 Gb/s")
    v = judge(st)
    assert v.label == "Thunderbolt 3 (40G) + 240W", v.label
    assert judge(PortState(port=2, connected=True)).label == "PWR ONLY"
    assert judge(PortState(port=2, connected=True, usb2_rate="480 Mbps (High Speed)")).label == "USB 2.0 (480M)"
    v = judge(PortState(port=2, connected=True, usb3_rate="5 Gbps", emarker=em))
    assert v.label.startswith("USB 3.2 Gen 1 (5G)") and any("overclaims" in x for x in v.notes)
    assert _whole_disk("disk4s2") == "disk4"
    print("self-test OK")
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--port", type=int, default=2, help="Mac USB-C port number used for testing (default 2)")
    ap.add_argument("--partner", default="Envoy Pro FX", help="name of the far-end device as macOS reports it")
    ap.add_argument("--volume", default="RazorCrest", help="volume on the partner to read from (read-only)")
    ap.add_argument("--seconds", type=float, default=8.0, help="length of the read test")
    ap.add_argument("--model", default=os.environ.get("CABLE_STATION_PTOUCH_MODEL", "PT-P950NW"),
                    help="ptouch-label --model (PT-P950NW = Iris, 179 office)")
    ap.add_argument("--auto-print", action="store_true", help="print every flag without asking")
    ap.add_argument("--no-print", action="store_true", help="never print")
    ap.add_argument("--dry-run", action="store_true", help="pass --dry-run to ptouch-label")
    ap.add_argument("--no-throughput", action="store_true", help="skip the read test")
    ap.add_argument("--once", action="store_true", help="test one cable and exit")
    ap.add_argument("--snapshot", action="store_true", help="report every port now and exit")
    ap.add_argument("--json", action="store_true", help="with --snapshot: JSON output for agents")
    ap.add_argument("--self-test", action="store_true", help="check the decoder against known cables")
    a = ap.parse_args()
    if a.self_test:
        return self_test()
    if a.snapshot:
        return snapshot(a)
    try:
        return run_station(a)
    except KeyboardInterrupt:
        print(f"\nStopped. Results: {RESULTS}")
        return 0


if __name__ == "__main__":
    sys.exit(main())
